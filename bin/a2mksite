#!/bin/sh

ask_yn() {
    local answer
    printf "%s [Y/n]: " "$1"
    
    while true; do
        read answer
        case "$answer" in
            [Yy]* | "") return 0 ;;
            [Nn]*) return 1 ;;
            *) echo "Please enter Y or N: " ;;
        esac
    done
}

# Hosts validation
hosts="/etc/hosts"
if [ ! -f "$hosts" ]; then
    echo "The system hosts file $hosts does not exist."
    exit 1
elif [ ! -w "$hosts" ]; then
    echo "The system hosts file $hosts is not writable."
    exit 1
fi

# Domain validation
while true; do
    read -p "Enter a domain name (e.g., example.com): " domain
    if [ -z "$domain" ]; then
        echo "Domain name is empty."
        continue
    elif grep -q "$domain" $hosts; then
        echo "The domain $domain already exists in $hosts, try another one."
        continue
    fi
    break
done

# Virtual hosts path validation
systems_vhosts="
/etc/apache2/sites-available
/etc/httpd/conf.d
/etc/apache2/vhosts.d
/etc/httpd/conf/extra
"

vhosts=""
for system_vhosts in $systems_vhosts; do
    if [ -d "$system_vhosts" ]; then
        vhosts=$system_vhosts
        break
    fi
done

if [ -z "$vhosts" ] || ! ask_yn "You want to use the founded virtual hosts path - $vhosts?"; then
    while true; do
        read -p "Enter the virtual hosts path: " vhosts
        if [ -z "$vhosts" ]; then
            echo "The path to virtual hosts is empty."
            continue
        elif [ ! -d "$vhosts" ]; then
            echo "The entered virtual hosts path does not exist: $vhosts."
            continue
        fi
        break
    done
fi

# Virtual host name validation
conf="${domain}.conf"
vhost="$vhosts/$conf"
if [ -f "$vhost" ] || ! ask_yn "You want to use a domain name for the virtual host - $conf?"; then
    while true; do
        read -p "Enter the virtual host name: " conf
        if [ -z "$conf" ]; then
            echo "The virtual host name is empty."
            continue
        elif [ -f "$vhosts/$conf" ]; then
            echo "The virtual host $vhosts/$conf already exists, try another one."
            continue
        fi
        vhost="$vhosts/$conf"
        break
    done
fi

# Site directory validation
# You can use an existing directory, as it is often necessary to set up a virtual host for a cloned Git repository.
dir="${PWD}/${domain}"
if ! ask_yn "Would you like to use the following site directory - $dir?"; then
    while true; do
        read -p "Enter the site directory: " dir
        if [ -z "$dir" ]; then
            echo "Site directory not provided."
            continue
        fi
        break
    done
fi

# Host validation
host="127.0.0.1"
if ! ask_yn "You wish to use the following host address - $host?"; then
    while true; do
        read -p "Enter the host address: " host
        if [ -z "$host" ]; then
            echo "Host address is empty."
            continue
        fi
        break
    done
fi

# Creating a virtual host
temp_conf=$(mktemp)
cat <<EOF > "$temp_conf"
<VirtualHost *:80>
    ServerName ${domain}
    ServerAlias ${domain}

    DocumentRoot ${dir}

    <Directory ${dir}>
        AllowOverride All
        Require all granted
    </Directory>
</VirtualHost>
EOF

if [ -z "$EDITOR" ]; then
    EDITOR="nano"
fi

"$EDITOR" "$temp_conf"
if [ ! -s "$temp_conf" ]; then
    rm -f "$temp_conf"
    echo "Error: the configuration file is empty or creation has been canceled."
    exit 1
fi

mv "$temp_conf" "$vhost"
echo "Virtual host config successfully saved in: $vhost."

# Creating a site directory
if [ ! -d "$dir" ]; then
    mkdir -p $dir
    if [ "$SUDO_USER" ]; then
        chown -R "$SUDO_USER:$SUDO_USER" $dir
    fi
    echo "The website directory has been created in: $dir."
fi

# Creating a record in /etc/hosts
echo "$host   $domain" >> $hosts
echo "The following entry has been added to /etc/hosts: $host   $domain."

# Enabling a virtual host
if [ -x "/usr/sbin/a2ensite" ]; then
    a2ensite $conf
fi

# Reload Apache
systemctl reload apache2
exit 0
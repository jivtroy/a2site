#!/bin/sh

ask_yn() {
    local answer
    printf "%s [Y/n]: " "$1"
    
    while true; do
        read answer
        case "$answer" in
            [Yy]* | "") return 0 ;;
            [Nn]*) return 1 ;;
            *) echo "Please enter Y or N: " ;;
        esac
    done
}

# Hosts validation
hosts="/etc/hosts"
if [ ! -f "$hosts" ]; then
    echo "The system hosts file $hosts does not exist."
    exit 1
elif [ ! -w "$hosts" ]; then
    echo "The system hosts file $hosts is not writable."
    exit 1
fi

# Domain validation
while true; do
    read -p "Enter a domain name (e.g., example.com): " domain
    if [ -z "$domain" ]; then
        echo "Domain name is empty."
        continue
    elif ! grep -qE "(^|[[:space:]])${domain}\b" "$hosts"; then
        echo "The domain $domain not exists in $hosts, try another one."
        continue
    fi
    break
done

# Virtual hosts path validation
systems_vhosts="
/etc/apache2/sites-available
/etc/httpd/conf.d
/etc/apache2/vhosts.d
/etc/httpd/conf/extra
"

vhosts=""
for system_vhosts in $systems_vhosts; do
    if [ -d "$system_vhosts" ]; then
        vhosts=$system_vhosts
        break
    fi
done

if [ -z "$vhosts" ] || ! ask_yn "You want to use the founded virtual hosts path - $vhosts?"; then
    while true; do
        read -p "Enter the virtual hosts path: " vhosts
        if [ -z "$vhosts" ]; then
            echo "The path to virtual hosts is empty."
            continue
        elif [ ! -d "$vhosts" ]; then
            echo "The entered virtual hosts path does not exist: $vhosts."
            continue
        fi
        break
    done
fi

# Virtual host name validation
conf="${domain}.conf"
vhost="$vhosts/$conf"
if [ ! -f "$vhost" ] || ! ask_yn "Is this the correct virtual host name - $conf?"; then
    while true; do
        read -p "Enter the virtual host name: " conf
        if [ -z "$conf" ]; then
            echo "The virtual host name is empty."
            continue
        elif [ ! -f "$vhosts/$conf" ]; then
            echo "The virtual host $vhosts/$conf not exists, try another one."
            continue
        fi
        vhost="$vhosts/$conf"
        break
    done
fi

# Site directory validation
dir="${PWD}/${domain}"
if [ ! -d "$dir" ] || ! ask_yn "Is this the correct site directory - $dir?"; then
    while true; do
        read -p "Enter the site directory: " dir
        if [ -z "$dir" ]; then
            echo "Site directory not provided."
            continue
        elif [ ! -d "$dir" ]; then
            echo "The directory $dir not exists, try another one."
            continue
        fi
        break
    done
fi

if [ -x "/usr/sbin/a2dissite" ]; then
    a2dissite $conf
fi

systemctl reload apache2

if sed -i -E "/^[[:space:]]*[^#]*([^.]|^)${domain}\b/d" "$hosts"; then
    echo "Domain removed from $hosts."
fi

if ask_yn "Confirm deletion of the site directory - $dir?"; then
    rm -R $dir
    echo "The following site directory has been deleted: $dir."
fi

if ask_yn "Confirm deletion of the virtual host config - $vhost?"; then
    rm $vhost
    echo "The following virtual host config has been removed: $vhost."
fi

exit 0